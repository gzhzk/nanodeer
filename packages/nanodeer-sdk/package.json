{
  "name": "nanodeer-sdk",
  "version": "0.1.0",
  "description": "NanoDeer TypeScript Shell — CLI and SDK for NanoDeer Agent",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "nanodeer": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "readline": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "optionalDependencies": {
    "@types/readline": "npm:readline@*"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
