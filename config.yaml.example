# ============================================================================
# NanoDeer Configuration
# ============================================================================
# Copy this file to `config.yaml` and customize it for your environment.
# Environment variables are available for all field values. Example: `api_key: $ANTHROPIC_API_KEY`

# ============================================================================
# Agent Defaults
# ============================================================================
# Default model and provider for all agents.
# Provider must be explicitly specified.

agents:
  defaults:
    model: MiniMax-M2.7  # Model name
    provider: minimax  # minimax, anthropic, openrouter, deepseek, moonshot, etc.
    max_tokens: 8192
    temperature: 0.1

# ============================================================================
# Provider Configurations
# ============================================================================
# Each provider only needs api_key (and optionally api_base if non-standard).
# Standard api_base values are predefined but can be overridden.

# Anthropic-compatible providers (use ChatAnthropic)
anthropic:
  api_key: $ANTHROPIC_API_KEY
  api_base: https://api.anthropic.com

openrouter:
  api_key: $OPENROUTER_API_KEY
  api_base: https://openrouter.ai/api/v1

deepseek:
  api_key: $DEEPSEEK_API_KEY
  api_base: https://api.deepseek.com/v1

moonshot:
  api_key: $MOONSHOT_API_KEY
  api_base: https://api.moonshot.cn/v1

zhipu:
  api_key: $ZHIPU_API_KEY
  api_base: https://open.bigmodel.cn/api/paas/v1

dashscope:
  api_key: $DASHSCOPE_API_KEY
  api_base: https://dashscope.aliyuncs.com/api/v1

minimax:
  api_key: $MINIMAX_API_KEY
  api_base: $MINIMAX_BASE_URL  # Set in environment

siliconflow:
  api_key: $SILICONFLOW_API_KEY
  api_base: https://api.siliconflow.cn

# OpenAI-compatible providers (use ChatOpenAI)
openai:
  api_key: $OPENAI_API_KEY
  api_base: https://api.openai.com/v1

gemini:
  api_key: $GEMINI_API_KEY
  api_base: https://generativelanguage.googleapis.com/v1beta

groq:
  api_key: $GROQ_API_KEY
  api_base: https://api.groq.com/openai/v1

ollama:
  api_base: http://localhost:11434/v1
  # No api_key needed for local

# ============================================================================
# Sandbox Configuration (Docker only - local removed for security)
# ============================================================================

sandbox:
  use: nanodeer.sandbox.docker:DockerSandboxProvider
  image: enterprise-public-cn-beijing.cr.volces.com/vefaas-public/all-in-one-sandbox:latest
  container_prefix: nanodeer-sandbox

# ============================================================================
# Subagents Configuration
# ============================================================================

subagents:
  timeout_seconds: 300
  max_concurrent: 3

# ============================================================================
# Thread Storage Configuration
# ============================================================================

thread:
  storage_path: ~/.nanodeer/threads
  checkpointer_type: memory

# ============================================================================
# Security Configuration
# ============================================================================

security:
  mode: default

# ============================================================================
# Logging Configuration
# ============================================================================

log_level: info