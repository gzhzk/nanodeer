# ============================================================================
# NanoDeer Configuration
# ============================================================================
# Copy this file to `config.yaml` and customize it for your environment.
# Environment variables are available for all field values. Example: `api_key: $MINIMAX_API_KEY`

# ============================================================================
# Models Configuration
# ============================================================================

models:
  - name: minimax-m2.7
    display_name: MiniMax M2.7
    use: langchain_anthropic:ChatAnthropic
    model: MiniMax-M2.7
    api_key: $MINIMAX_API_KEY
    base_url: $MINIMAX_BASE_URL
    request_timeout: 600.0
    max_retries: 2
    max_tokens: 4096
    supports_vision: true
    supports_thinking: true

# ============================================================================
# Sandbox Configuration (Docker only - local removed for security)
# ============================================================================

sandbox:
  use: nanodeer.sandbox.docker:DockerSandboxProvider
  image: enterprise-public-cn-beijing.cr.volces.com/vefaas-public/all-in-one-sandbox:latest
  replicas: 3
  container_prefix: nanodeer-sandbox
  port: 8080

# ============================================================================
# Subagents Configuration
# ============================================================================

subagents:
  timeout_seconds: 900
  max_concurrent: 3

# ============================================================================
# Memory Configuration
# ============================================================================

memory:
  enabled: true
  storage_path: memory.json
  debounce_seconds: 30
  max_facts: 100
  fact_confidence_threshold: 0.7
  injection_enabled: true
  max_injection_tokens: 2000

# ============================================================================
# Thread Storage Configuration
# ============================================================================

thread:
  storage_path: /tmp/nanodeer/threads
  checkpointer_type: memory

# ============================================================================
# Security Configuration
# ============================================================================

security:
  mode: default

# ============================================================================
# Logging Configuration
# ============================================================================

log_level: info
