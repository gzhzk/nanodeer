# NanoDeer Configuration

# LLM Provider - Anthropic
# ANTHROPIC_API_KEY=sk-ant-api03-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# LLM Provider - MiniMax
MINIMAX_API_KEY=your_api_key_here
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_MODEL=MiniMax-M2.7

# Sandbox Type: "docker"
SANDBOX_TYPE=docker

# Thread Storage Path
THREAD_STORAGE_PATH=/tmp/nanodeer/threads

# Memory Storage Path
MEMORY_STORAGE_PATH=/tmp/nanodeer/memory

# Security Permission Mode: "default", "plan", "auto", "bypass"
SECURITY_MODE=default

# Feishu (optional)
# FEISHU_APP_ID=cli_...
# FEISHU_APP_SECRET=...
# FEISHU_BOT_NAME=NanoDeer
