# NanoDeer Configuration
# Copy this file to .env and fill in your API keys

# ============================================================================
# LLM Provider API Keys
# ============================================================================
# Only the providers you want to use need API keys.
# Provider auto-detection uses model name prefix (e.g., "deepseek/..." -> deepseek)

# Anthropic (Official)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (Official)
# OPENAI_API_KEY=sk-...

# OpenRouter (Multi-provider proxy)
# OPENROUTER_API_KEY=sk-or-...

# DeepSeek
# DEEPSEEK_API_KEY=sk-...

# Moonshot (Kimi)
# MOONSHOT_API_KEY=sk-...

# 智谱 AI (Zhipu/GLM)
# ZHIPU_API_KEY=sk-...

# 阿里百炼 (DashScope/Qwen)
# DASHSCOPE_API_KEY=sk-...

# MiniMax (国内推荐)
# MINIMAX_API_KEY=your_api_key_here
# MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic

# SiliconFlow (Multi-provider proxy, supports many models)
# SILICONFLOW_API_KEY=sk-...

# Google Gemini
# GEMINI_API_KEY=AIza...

# Groq (Fast inference)
# GROQ_API_KEY=gsk_...

# Ollama (Local models)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# No API key needed for local

# ============================================================================
# Sandbox Configuration
# ============================================================================
# SANDBOX_TYPE=docker
# DOCKER_HOST=tcp://localhost:2375

# ============================================================================
# Storage Paths
# ============================================================================
# THREAD_STORAGE_PATH=/tmp/nanodeer/threads
# MEMORY_STORAGE_PATH=/tmp/nanodeer/memory

# ============================================================================
# Security Permission Mode
# ============================================================================
# Options: default, plan, auto, bypass
# SECURITY_MODE=default

# ============================================================================
# Feishu (Optional - for bot integration)
# ============================================================================
# FEISHU_APP_ID=cli_...
# FEISHU_APP_SECRET=...
# FEISHU_BOT_NAME=NanoDeer